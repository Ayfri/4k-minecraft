{
  "name": "4k-minecraft",
  "type": "module",
  "private": true,
  "scripts": {
    "bench": "bun scripts/bench.ts",
    "bot": "bun scripts/bot.ts",
    "build": "bun scripts/build.ts",
    "check": "tsc",
    "deploy": "bun scripts/build.ts && wrangler deploy",
    "dev": "bun scripts/serve.ts",
    "gate": "bun scripts/gate.ts",
    "screenshots": "bun scripts/screenshots.ts",
    "test": "bun test",
    "test:bot": "bun scripts/build.ts --dev && bun test --path-ignore-patterns \"node_modules/**\" scripts/house.bot.test.ts",
    "test:e2e": "bun scripts/build.ts && bun test scripts/e2e.test.ts",
    "test:fuzz": "bun test --path-ignore-patterns \"node_modules/**\" scripts/pack.fuzz.test.ts",
    "verify": "bun scripts/verify.ts"
  },
  "devDependencies": {
    "@gfx/zopfli": "^1.0.15",
    "@types/bun": "^1.4.3",
    "@types/eslint-scope": "^9.1.0",
    "@types/estree": "^1.0.9",
    "@webgpu/types": "^0.1.74",
    "acorn": "^8.19.0",
    "eslint-scope": "^9.1.2",
    "typescript": "^7.0.2",
    "wrangler": "^4.151.0"
  }
}
